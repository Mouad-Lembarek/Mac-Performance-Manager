# Mac Performance Manager - configuration
#
# Copy to config.env (next to the script) and edit:
#     cp config.env.example config.env
#
# Format: KEY=VALUE, one per line. Lines starting with # are comments.
# This file is PARSED, never executed: only the keys below are accepted, every
# value is validated, and invalid values are reported and replaced by defaults.
# Check the result with: ./mac-performance-manager.sh --check-config

# --- Sampling ------------------------------------------------------------------
# Live dashboard refresh, seconds (2-60).
LIVE_INTERVAL_SEC=4
# Work mode sampling interval, seconds (5-3600). 30 s is light and responsive enough.
WORK_INTERVAL_SEC=30
# Work mode samples less often while the Mac is calm, to save the manager's own CPU:
# after WORK_RELAX_AFTER_SAMPLES calm samples in a row (0 = never relax) it samples every
# WORK_RELAXED_INTERVAL_SEC (5-3600, not lower than WORK_INTERVAL_SEC). Any pressure
# restores WORK_INTERVAL_SEC immediately.
WORK_RELAXED_INTERVAL_SEC=60
WORK_RELAX_AFTER_SAMPLES=10
# How often work mode re-reads disk space, seconds (60-86400).
DISK_CHECK_INTERVAL_SEC=600
# Consecutive samples a condition must persist before it counts as "sustained" (1-60).
# With WORK_INTERVAL_SEC=30 and 3 samples, a problem must last about 1.5 minutes.
SUSTAINED_SAMPLES=3

# --- Memory --------------------------------------------------------------------
# macOS's own "free memory" estimate (kern.memorystatus_level, the number shown by
# the memory_pressure tool). Below WARN counts as elevated pressure, below CRIT as
# critical. The kernel's own pressure level (warning/critical) is always respected too.
# CRIT must be lower than WARN.
PRESSURE_WARN_FREE_PCT=20
PRESSURE_CRIT_FREE_PCT=10
# Swap growth within the trend window that counts as "growing" (MB).
SWAP_GROWTH_WARN_MB=1024
# Window for the swap trend, minutes (5-1440).
SWAP_TREND_WINDOW_MIN=30
# Swap-out rate (pages per second; 1 page = 16 KB on Apple Silicon) that counts as
# active swapping. 50 pages/s = 0.8 MB/s.
SWAPOUT_RATE_WARN_PAGES=50
# An application group above this % of RAM is named in recommendations (1-100).
# The cutoff never exceeds 1 GB (so large-RAM Macs still get advice), and when no group
# reaches it the 3 largest groups are named instead.
APP_HEAVY_PCT=10
# "Applications you could close" lists idle apps using at least this much (MB).
APP_CANDIDATE_MIN_MB=300

# --- CPU -----------------------------------------------------------------------
# Per-process CPU (% of ONE core; 100 = one full core) that counts as busy.
CPU_PROC_WARN_PCT=80
# Whole-machine CPU busy % (1-100) that counts as high.
CPU_TOTAL_WARN_PCT=85

# --- Disk ----------------------------------------------------------------------
# Free space on the startup disk (GB). CRIT must be lower than WARN.
DISK_FREE_WARN_GB=20
DISK_FREE_CRIT_GB=10
# Maximum folder depth for targeted artifact scans (1-20).
SCAN_MAX_DEPTH=6

# --- Work session ----------------------------------------------------------------
# Development processes smaller than this (MB, physical footprint) are not listed by key k.
DEV_CANDIDATE_MIN_MB=100
# Save reports/report-session-*.txt when a work session ends (the summary is always printed).
SESSION_REPORT_ENABLED=true
# --- Automatic actions (each one is OFF unless you set it to true) ----------------------
# They happen only under SUSTAINED high/critical memory pressure, least disruptive first, and
# are announced AUTO_ACTION_GRACE_SEC (10-600) ahead: press x in the work session to cancel.
# Right before acting, every protection, the process identity (PID reuse), idleness and
# pressure are checked again. SIGTERM only, never SIGKILL, nothing is restarted. "Idle" means
# average CPU <= 0.5% of one core (+1 s) during the whole idle period, as observed by the
# session. Apps, terminals and AI agents are never quit; files are never deleted.
#
# Idle TypeScript language servers whose parent is an editor extension host (Cursor/VS Code),
# with no busy child process. Cursor starts a new one when that project needs it.
AUTO_STOP_IDLE_TSSERVER=false
AUTO_TSSERVER_IDLE_MIN=30
# Idle local dev servers: a `next dev` or `vite` launcher under your home folder with a
# package.json and a listening port. It must have no browser/client connected, and no
# project file changed during the idle period (node_modules, .next, dist and .git are ignored).
# No build/test/lint may run under it or in the same project (recognised by command line), it
# must not have been started by an AI agent, and no AI agent may be working in the project.
# Stops the launcher (like Ctrl+C); not restarted. Needs lsof; without it nothing is stopped.
AUTO_STOP_IDLE_DEVSERVER=false
AUTO_DEVSERVER_IDLE_MIN=30
# Remove stale temporary files the manager itself left in state/ (.times.PID,
# history.tsv.tmp.PID) after an interrupted run: regular files you own, older than 10
# minutes, whose manager process has ended. Nothing else is ever deleted automatically.
AUTO_CLEAN_MANAGER_TEMP=false
AUTO_ACTION_GRACE_SEC=60
# Minutes between automatic actions (1-1440), maximum automatic actions per session
# (0-100; 0 = none), and how many actions without measurable benefit pause a rule (1-10).
AUTO_COOLDOWN_MIN=10
AUTO_MAX_ACTIONS=4
AUTO_MAX_INEFFECTIVE=2

# --- Logging, history, reports --------------------------------------------------
# Important events only (state changes, confirmed actions). Never command lines.
LOGGING_ENABLED=true
# events.log is rotated to events.log.1 above this size (KB).
LOG_MAX_KB=512
# Swap/pressure history used for trends (one small line per HISTORY_INTERVAL_SEC).
HISTORY_ENABLED=true
HISTORY_INTERVAL_SEC=60
HISTORY_MAX_LINES=5000
# Number of saved reports to keep.
REPORT_KEEP=20
# Where logs/, reports/ and state/ live. Empty = next to the script. Absolute path or ~/...
DATA_DIR=

# --- Interface -------------------------------------------------------------------
# macOS notifications from work mode, only for sustained problems.
NOTIFICATIONS_ENABLED=true
# Minimum minutes between notifications (and between repeated recommendations).
NOTIFY_COOLDOWN_MIN=30
# Seconds to wait after a graceful SIGTERM before offering (never forcing) SIGKILL.
KILL_GRACE_SEC=10
# Number of rows in the top-process lists (5-50).
TOP_N=15
# auto | always | never   (NO_COLOR in the environment also disables colors)
COLOR=auto
